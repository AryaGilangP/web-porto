{
  "version": 2,
  "builds": [
    {
      "src": "config/asgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/core/(.*)",
      "dest": "/static_deployed/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static_deployed/$1"
    },
    {
      "src": "/(.*)",
      "dest": "config/asgi.py"
    }
  ]
}